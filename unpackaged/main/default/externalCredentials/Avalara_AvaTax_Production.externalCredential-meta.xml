<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Password</authenticationProtocol>
    <description>Avalara AvaTax REST API v2 - Production. Salesforce Username field = Avalara accountId. Salesforce Password field = Avalara licenseKey. Configure both values in Setup after deploy.</description>
    <externalCredentialParameters>
        <parameterGroup>NamedPrincipal</parameterGroup>
        <parameterName>Username</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>REPLACE_WITH_PRODUCTION_ACCOUNT_ID</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>NamedPrincipal</parameterGroup>
        <parameterName>Password</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>REPLACE_WITH_PRODUCTION_LICENSE_KEY</parameterValue>
    </externalCredentialParameters>
    <label>Avalara AvaTax Production</label>
</ExternalCredential>
