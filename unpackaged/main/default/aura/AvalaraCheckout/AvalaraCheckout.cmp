<aura:component description="Avalara Tax Checkout SparkPlug" controller="AvalaraCheckoutService" implements="FDService:SparkPlugComponentInterface" access="global">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:registerEvent type="FDService:SparkPlugCompleteEvent" name="SparkPlugCompleteEvent"/>
    <aura:registerEvent type="FDService:SparkPlugLoadedEvent" name="SparkPlugLoadedEvent"/>

    <!-- State -->
    <aura:attribute name="step" type="String" default="loading"/>
    <aura:attribute name="errorMessage" type="String"/>
    <aura:attribute name="isSaving" type="Boolean" default="false"/>

    <!-- Checkout data -->
    <aura:attribute name="taxableItems" type="List"/>
    <aura:attribute name="entityId" type="String"/>
    <aura:attribute name="entityType" type="String"/>
    <aura:attribute name="street" type="String"/>
    <aura:attribute name="city" type="String"/>
    <aura:attribute name="state" type="String"/>
    <aura:attribute name="postalCode" type="String"/>
    <aura:attribute name="country" type="String"/>
    <aura:attribute name="saveForFuture" type="Boolean" default="false"/>

    <!-- Loading -->
    <aura:if isTrue="{!v.step == 'loading'}">
        <div class="slds-align_absolute-center slds-m-around_large">
            <lightning:spinner alternativeText="Loading..." size="small"/>
        </div>
    </aura:if>

    <!-- Step 1: Review -->
    <aura:if isTrue="{!v.step == 'review'}">
        <div class="avalara-checkout">
            <div class="avalara-checkout__card">
                <div class="avalara-checkout__icon-wrapper">
                    <lightning:icon iconName="utility:cart" size="large" alternativeText="Tax"/>
                </div>
                <h2 class="avalara-checkout__title">Tax Review</h2>
                <p class="avalara-checkout__subtitle">
                    The following items are subject to tax. Tax will be calculated based on your shipping address.
                </p>

                <div class="avalara-checkout__exemption-notice">
                    <lightning:icon iconName="utility:info" size="x-small" class="avalara-checkout__exemption-icon"/>
                    <span>If you believe your organization is tax exempt, please contact customer service for assistance.</span>
                </div>

                <table class="avalara-checkout__table">
                    <thead>
                        <tr>
                            <th class="avalara-checkout__th">Item</th>
                            <th class="avalara-checkout__th avalara-checkout__th--right">Qty</th>
                            <th class="avalara-checkout__th avalara-checkout__th--right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <aura:iteration items="{!v.taxableItems}" var="item">
                            <tr class="avalara-checkout__tr">
                                <td class="avalara-checkout__td">{!item.name}</td>
                                <td class="avalara-checkout__td avalara-checkout__td--right">{!item.quantity}</td>
                                <td class="avalara-checkout__td avalara-checkout__td--right">
                                    <lightning:formattedNumber value="{!item.total}" style="currency" currencyCode="USD"/>
                                </td>
                            </tr>
                        </aura:iteration>
                    </tbody>
                </table>

                <div class="avalara-checkout__address-section">
                    <p class="avalara-checkout__address-label">Shipping address</p>
                    <div class="avalara-checkout__address-display">
                        <p>{!v.street}</p>
                        <p>{!v.city}{!if(and(not(empty(v.city)), not(empty(v.state))), ', ', '')}{!v.state}{!if(and(not(empty(v.state)), not(empty(v.postalCode))), ', ', '')}{!v.postalCode}</p>
                        <p>{!v.country}</p>
                    </div>
                </div>

                <div class="avalara-checkout__actions">
                    <button class="avalara-checkout__button avalara-checkout__button--primary" onclick="{!c.handleContinue}">
                        Continue
                    </button>
                    <button class="avalara-checkout__button avalara-checkout__button--secondary" onclick="{!c.handleEdit}">
                        Edit Address
                    </button>
                </div>
            </div>
        </div>
    </aura:if>

    <!-- Step 2: Edit Address -->
    <aura:if isTrue="{!v.step == 'editing'}">
        <div class="avalara-checkout">
            <div class="avalara-checkout__card">
                <div class="avalara-checkout__icon-wrapper">
                    <lightning:icon iconName="utility:location" size="large" alternativeText="Address"/>
                </div>
                <h2 class="avalara-checkout__title">Update Shipping Address</h2>

                <aura:if isTrue="{!not(empty(v.errorMessage))}">
                    <div class="avalara-checkout__error">
                        {!v.errorMessage}
                    </div>
                </aura:if>

                <div class="avalara-checkout__form">
                    <div class="avalara-checkout__field">
                        <lightning:input label="Street" value="{!v.street}" name="street" required="true"/>
                    </div>
                    <div class="avalara-checkout__row">
                        <div class="avalara-checkout__col">
                            <lightning:input label="City" value="{!v.city}" name="city" required="true"/>
                        </div>
                        <div class="avalara-checkout__col">
                            <lightning:input label="State" value="{!v.state}" name="state" required="true"/>
                        </div>
                    </div>
                    <div class="avalara-checkout__row">
                        <div class="avalara-checkout__col">
                            <lightning:input label="Postal Code" value="{!v.postalCode}" name="postalCode" required="true"/>
                        </div>
                        <div class="avalara-checkout__col">
                            <lightning:input label="Country" value="{!v.country}" name="country" required="true"/>
                        </div>
                    </div>
                    <div class="avalara-checkout__checkbox">
                        <lightning:input type="checkbox" label="Use this address for future purchases" checked="{!v.saveForFuture}" name="saveForFuture"/>
                        <lightning:helptext content="If checked, this address will be saved to your profile and used for this and all future orders. If unchecked, the change applies only to this order."/>
                    </div>
                </div>

                <aura:if isTrue="{!v.isSaving}">
                    <div class="slds-align_absolute-center slds-m-around_medium">
                        <lightning:spinner alternativeText="Saving..." size="small"/>
                    </div>
                    <aura:set attribute="else">
                        <div class="avalara-checkout__actions">
                            <button class="avalara-checkout__button avalara-checkout__button--primary" onclick="{!c.handleSaveAddress}">
                                Save &amp; Continue
                            </button>
                            <button class="avalara-checkout__button avalara-checkout__button--secondary" onclick="{!c.handleBackToReview}">
                                Back
                            </button>
                        </div>
                    </aura:set>
                </aura:if>
            </div>
        </div>
    </aura:if>

    <!-- Step 3: Processing -->
    <aura:if isTrue="{!v.step == 'processing'}">
        <div class="avalara-checkout">
            <div class="avalara-checkout__card avalara-checkout__card--processing">
                <div class="avalara-checkout__spinner-wrapper">
                    <lightning:spinner alternativeText="Calculating taxes..." size="medium"/>
                </div>
                <h2 class="avalara-checkout__title">Calculating Tax</h2>
                <p class="avalara-checkout__subtitle">Validating your address and calculating applicable taxes...</p>
            </div>
        </div>
    </aura:if>

    <aura:html tag="style">
        .avalara-checkout {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 400px;
            padding: 40px 20px;
        }
        .avalara-checkout__card {
            background: #ffffff;
            border: 1px solid #d8dde6;
            border-top: 4px solid #1a4a6e;
            border-radius: 4px;
            padding: 40px 48px;
            max-width: 680px;
            width: 90%;
            text-align: center;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
        }
        .avalara-checkout__icon-wrapper {
            margin-bottom: 16px;
        }
        .avalara-checkout__icon-wrapper .slds-icon-utility-cart,
        .avalara-checkout__icon-wrapper .slds-icon-utility-location {
            fill: #1a4a6e;
        }
        .avalara-checkout__title {
            font-size: 22px;
            font-weight: 600;
            color: #1a4a6e;
            margin-bottom: 8px;
        }
        .avalara-checkout__subtitle {
            font-size: 14px;
            color: #54698d;
            line-height: 1.5;
            margin-bottom: 24px;
        }
        .avalara-checkout__table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-bottom: 28px;
            text-align: left;
        }
        .avalara-checkout__th {
            font-size: 12px;
            font-weight: 600;
            color: #1a4a6e;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 12px;
            border-bottom: 2px solid #d8dde6;
        }
        .avalara-checkout__th--right {
            text-align: right;
        }
        .avalara-checkout__td {
            font-size: 14px;
            color: #3e3e3c;
            padding: 10px 12px;
            border-bottom: 1px solid #e8e8e8;
        }
        .avalara-checkout__td--right {
            text-align: right;
        }
        .avalara-checkout__tr:last-child .avalara-checkout__td {
            border-bottom: none;
        }
        .avalara-checkout__address-section {
            background: #f4f6f9;
            border-radius: 4px;
            padding: 16px 20px;
            margin-bottom: 24px;
            text-align: left;
        }
        .avalara-checkout__address-label {
            font-size: 13px;
            font-weight: 600;
            color: #1a4a6e;
            margin-bottom: 8px;
        }
        .avalara-checkout__address-display {
            font-size: 14px;
            color: #3e3e3c;
            line-height: 1.6;
        }
        .avalara-checkout__error {
            font-size: 14px;
            color: #c23934;
            background: #fef1f1;
            border: 1px solid #f5c6c6;
            border-radius: 4px;
            padding: 12px 16px;
            margin-bottom: 20px;
            line-height: 1.5;
            text-align: left;
        }
        .avalara-checkout__form {
            text-align: left;
            margin-bottom: 24px;
        }
        .avalara-checkout__field {
            margin-bottom: 12px;
        }
        .avalara-checkout__row {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
        }
        .avalara-checkout__col {
            flex: 1;
        }
        .avalara-checkout__checkbox {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-top: 8px;
        }
        .avalara-checkout__actions {
            display: flex;
            justify-content: center;
            gap: 12px;
        }
        .avalara-checkout__button {
            padding: 10px 28px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            border: none;
        }
        .avalara-checkout__button--primary {
            background: #1a4a6e;
            color: #ffffff;
        }
        .avalara-checkout__button--primary:hover {
            background: #153d5b;
        }
        .avalara-checkout__button--secondary {
            background: transparent;
            color: #1a4a6e;
            border: 1px solid #1a4a6e;
        }
        .avalara-checkout__button--secondary:hover {
            background: #f4f6f9;
        }
        .avalara-checkout__card--processing {
            padding: 60px 48px;
        }
        .avalara-checkout__spinner-wrapper {
            position: relative;
            height: 60px;
            margin-bottom: 20px;
        }
        .avalara-checkout__exemption-notice {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f4f6f9;
            border: 1px solid #d8dde6;
            border-left: 4px solid #1a4a6e;
            border-radius: 4px;
            padding: 10px 16px;
            margin-bottom: 20px;
            font-size: 13px;
            color: #54698d;
            text-align: left;
        }
        .avalara-checkout__exemption-icon {
            --slds-c-icon-color-foreground-default: #1a4a6e;
            flex-shrink: 0;
        }
        .slds-popover_tooltip .slds-popover__body,
        .slds-popover--tooltip .slds-popover__body,
        .slds-popover_tooltip,
        .slds-popover--tooltip {
            color: #ffffff !important;
        }
    </aura:html>
</aura:component>